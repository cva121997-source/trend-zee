{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "premium-trend-zee-upgrade": false
    }
  },
  "github": {
    "autoAlias": false
  }
}
